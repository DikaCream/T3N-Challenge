# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env (it is gitignored).
# ---------------------------------------------------------------------------

# REQUIRED ---------------------------------------------------------------
# Your T3N key from https://www.terminal3.io/claim-page — shown once, copy it
# now. It is an Ethereum private key used to sign the login challenge: treat it
# with the same care as any wallet key. It never leaves this machine.
T3N_API_KEY=

# Which T3N cluster to talk to: testnet | sandbox | production.
T3N_ENV=testnet

# ONBOARDING TARGETS -----------------------------------------------------
# Where the contract sends each step. Any HTTPS endpoint works: point these at
# httpbin.org/post, a webhook.site URL, or your own HRIS/payroll sandbox.
#
# `config` map keys written by `hr-onboard init`, NOT read directly by the
# contract — the contract only reads them back out of the enclave.
ONBOARD_IDENTITY_ENDPOINT=https://httpbin.org/post
ONBOARD_PAYROLL_ENDPOINT=https://httpbin.org/post

# Extra headers per step, as a JSON object string. Optional.
# ONBOARD_IDENTITY_HEADERS={"X-Tenant":"acme"}
# ONBOARD_PAYROLL_HEADERS={"X-Tenant":"acme"}

# Upstream credentials, written into the private `secrets` map by
# `hr-onboard seed`. Only the contract can read them back. Optional — leave
# blank if your endpoint needs no bearer token.
HRIS_API_KEY=
PAYROLL_API_KEY=

# AGENT DELEGATION (optional) --------------------------------------------
# An agent acting on a user's behalf needs its own DID and its own credits.
# Register one at the same claim page, then grant it scoped access with:
#   hr-onboard grant --agent <agent-did>
AGENT_DID=

# WEB CONSOLE (optional) --------------------------------------------
# The Next.js console (`npm run dev`) runs the contract in dry-run mode unless
# this is exactly `true`. Leave it unset on any publicly reachable deployment:
# the key in this file can spend the tenant's credits, so a URL that anyone can
# hit must not be able to send real outbound onboarding traffic.
# ONBOARD_ALLOW_LIVE=true

# AGENT PLANNER (optional) ------------------------------------------------
# Without these the agent uses a deterministic planner and says so in its
# rationale. Set them to let a model choose which steps to run.
# No PII is ever sent to the model: it only sees employee_ref, role,
# department and start_date.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
