{
  "name": "hr-onboard-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving employee onboarding agent on Terminal 3 (T3N). The agent plans on non-sensitive data; a TEE contract acts; employee PII is resolved host-side inside the enclave and never enters application memory.",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build:contract": "cargo build --manifest-path contracts/employee-onboarding/Cargo.toml --release --target wasm32-wasip2",
    "test:contract": "cargo test --manifest-path contracts/employee-onboarding/Cargo.toml --target x86_64-unknown-linux-gnu --lib",
    "test": "npm run typecheck && npm run test:contract"
  },
  "dependencies": {
    "@terminal3/t3n-sdk": "5.2.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
